name = "mopme-notice-bot"
main = "src/index.ts"
compatibility_date = "2025-09-01"
workers_dev = true

[triggers]
crons = ["*/2 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "mopme-notice-bot"
database_id = "Replace with the DB ID"
migrations_dir = "migrations"

[observability]
enabled = true
